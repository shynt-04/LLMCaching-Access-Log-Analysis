# Provider defaults for the current Docker demo.
LLM_PROVIDER="nvidia"
CACHE_EMBED_PROVIDER="nvidia"

# NVIDIA NIM settings.
NVIDIA_API_KEY="add_key_here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_LLM_MODEL="google/gemma-4-31b-it"
NVIDIA_EMBED_MODEL="nvidia/llama-nemotron-embed-1b-v2"

# Optional Ollama settings.
# To use Ollama locally, switch the provider values above:
# LLM_PROVIDER="ollama"
# CACHE_EMBED_PROVIDER="ollama"
# If the app runs in Docker and Ollama runs on the host, use:
# OLLAMA_HOST="http://host.docker.internal:11434"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional alternative LLM API providers.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-haiku-4-5-20251001"

# Demo input settings.
LOG_INPUT_DIR="input"
LOG_SOURCE="auto"
USE_CACHE="true"
AUTO_START_ANALYSIS="true"
